# Local project configuration example
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=xhigh
XAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
SKU_MAPPING_AI_PROVIDER=openai
OPENAI_SKU_MAPPING_MODEL=gpt-5.6-luna
OPENAI_SKU_MAPPING_REASONING_EFFORT=low
XAI_SKU_MAPPING_MODEL=grok-4.5
GEMINI_SKU_MAPPING_MODEL=gemini-3.5-flash-lite
DEEPSEEK_SKU_MAPPING_MODEL=deepseek-v4-flash
# 1688 uses ego-lite when available; the cart workflow falls back to Chrome/Chromium when it is not installed.
EGO_BROWSER_COMMAND=ego-browser
EGO_BROWSER_TASK_SPACE=InventoryCalculater 1688 live scan
EGO_BROWSER_RESTOCK_TASK_SPACE=InventoryCalculater 1688 restock
# auto: prefer ego-lite and fall back only when unavailable; ego/playwright: force one backend.
ALIBABA_RESTOCK_BROWSER=auto
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_REFRESH_TOKEN=
# 先以唯讀預覽驗證真實訂單；確認流程正確後才改為 true。
SHOPEE_INBOUND_WRITE_ENABLED=false
